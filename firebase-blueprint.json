{
  "entities": {
    "Rsvp": {
      "title": "Rsvp",
      "description": "Guest RSVP submission for Jacinta and Maurice's wedding",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the RSVP record"
        },
        "fullName": {
          "type": "string",
          "description": "Full name of the guest",
          "maxLength": 100
        },
        "phoneNumber": {
          "type": "string",
          "description": "Contact phone number for confirmation",
          "maxLength": 30
        },
        "willAttend": {
          "type": "string",
          "enum": ["yes", "no"],
          "description": "Attendance status"
        },
        "adultsCount": {
          "type": "number",
          "description": "Number of adult guests attending"
        },
        "childrenCount": {
          "type": "number",
          "description": "Number of children attending"
        },
        "submittedAt": {
          "type": "string",
          "description": "ISO timestamp of RSVP submission"
        },
        "eCardCode": {
          "type": "string",
          "description": "Unique admission e-card code"
        },
        "notes": {
          "type": "string",
          "description": "Optional dietary notes or heartfelt wishes from guest",
          "maxLength": 500
        }
      },
      "required": ["id", "fullName", "phoneNumber", "willAttend", "adultsCount", "submittedAt", "eCardCode"]
    }
  },
  "firestore": {
    "/rsvps/{rsvpId}": {
      "schema": {
        "$ref": "#/entities/Rsvp"
      },
      "description": "Collection of wedding RSVP responses submitted by guests and managed by the couple"
    }
  }
}
