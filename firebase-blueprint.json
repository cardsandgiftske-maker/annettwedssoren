{
  "entities": {
    "rsvp": {
      "title": "RSVP",
      "description": "Wedding guest RSVP submission record",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the RSVP"
        },
        "fullName": {
          "type": "string",
          "description": "Full name of the guest",
          "minLength": 1,
          "maxLength": 100
        },
        "phoneNumber": {
          "type": "string",
          "description": "Phone number of the guest",
          "minLength": 5,
          "maxLength": 30
        },
        "willAttend": {
          "type": "string",
          "description": "Attendance confirmation",
          "enum": ["yes", "no"]
        },
        "adultsCount": {
          "type": "number",
          "description": "Number of attending adults"
        },
        "childrenCount": {
          "type": "number",
          "description": "Number of attending children"
        },
        "submittedAt": {
          "type": "string",
          "description": "ISO timestamp of submission"
        },
        "eCardCode": {
          "type": "string",
          "description": "Personal digital invitation code"
        },
        "notes": {
          "type": "string",
          "description": "Optional notes or blessings for the couple",
          "maxLength": 500
        },
        "songRequest": {
          "type": "string",
          "description": "Optional song request",
          "maxLength": 200
        }
      },
      "required": ["id", "fullName", "phoneNumber", "willAttend", "submittedAt", "eCardCode"]
    }
  },
  "firestore": {
    "/rsvps/{rsvpId}": {
      "schema": {
        "$ref": "#/entities/rsvp"
      },
      "description": "Collection of wedding guest RSVPs"
    }
  }
}
